{
  "name": "audiohub-store",
  "version": "1.0.0",
  "description": "AudioHub - Hệ thống quản lý cửa hàng tai nghe và thiết bị âm thanh (Node.js + PostgreSQL, triển khai trên Render)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/smoke.test.js",
    "bench": "node scripts/benchmark.js",
    "db:init": "node db/init.js",
    "db:reset": "node db/init.js --reset"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "cloudinary": "^2.11.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-handlebars": "^7.1.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.12.0"
  }
}
