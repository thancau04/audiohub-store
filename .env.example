# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG commit file .env lên GitHub.

# Cổng chạy ứng dụng (trên Render biến PORT do Render tự cấp, không cần khai báo)
PORT=3000

# Chuỗi kết nối PostgreSQL
# - Chạy local với PostgreSQL cài trên máy:
#   DATABASE_URL=postgresql://postgres:matkhau@localhost:5432/audiohub
# - Chạy local nhưng kết nối DB trên Render: dán "External Database URL" của Render
#   DATABASE_URL=postgresql://user:password@dpg-xxxx-a.singapore-postgres.render.com/dbname
# - Trên Render Web Service: dán "Internal Database URL" vào mục Environment
DATABASE_URL=postgresql://postgres:matkhau@localhost:5432/audiohub

# (Tùy chọn) Ép bật/tắt SSL: true | false. Bỏ trống để tự nhận diện:
# host là localhost -> tắt SSL; host có tên miền (External URL) -> bật SSL
# DB_SSL=

# (Tùy chọn) true = khi server khởi động tự tạo bảng và nạp dữ liệu mẫu nếu chưa có
# AUTO_DB_INIT=false

# Khóa bí mật ký session cookie (trên Render cần khai báo chuỗi ngẫu nhiên dài)
SESSION_SECRET=thay-bang-chuoi-bi-mat-ngau-nhien-dai

# Cloudinary (tùy chọn – dùng để upload file ảnh sản phẩm lên cloud)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
