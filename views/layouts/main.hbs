<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · AudioHub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="/">
        <span class="brand-mark">{{> icon name="headphones"}}</span>
        <span>Audio<span class="brand-accent">Hub</span></span>
      </a>
      <nav class="nav">
        <a class="nav-link {{#if (eq navActive "home")}}is-active{{/if}}" href="/">{{> icon name="dashboard"}} Tổng quan</a>
        <a class="nav-link {{#if (eq navActive "products")}}is-active{{/if}}" href="/products">{{> icon name="package"}} Sản phẩm</a>
        <span class="nav-divider"></span>
        <a class="btn btn-primary btn-sm" href="/products/new">{{> icon name="plus"}} Thêm sản phẩm</a>
      </nav>
    </div>
  </header>

  <main class="container">
    {{{body}}}
  </main>

  <footer class="footer">
    <div class="container">
      AudioHub · Hệ thống quản lý cửa hàng tai nghe và thiết bị âm thanh · Node.js + PostgreSQL trên Render.
    </div>
  </footer>
</body>

</html>
