<div class="page-head">
  <div>
    <h1>Sản phẩm</h1>
    <p class="page-sub">Quản lý danh mục tai nghe và thiết bị âm thanh.</p>
  </div>
  {{#if currentUser}}
  <a class="btn btn-primary" href="/products/new">{{> icon name="plus"}} Thêm sản phẩm</a>
  {{/if}}
</div>

{{#if flash}}<div class="alert alert-ok">{{> icon name="check-circle"}}<span>{{flash}}</span></div>{{/if}}

<form class="search-bar" action="/products" method="get">
  <div class="input-icon">
    {{> icon name="search"}}
    <input type="search" name="q" value="{{q}}" placeholder="Tìm theo tên, thương hiệu hoặc mã SKU...">
  </div>
  <select name="category">
    <option value="">Tất cả danh mục</option>
    {{#each categories}}
    <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
    {{/each}}
  </select>
  <button class="btn btn-primary" type="submit">Tìm kiếm</button>
  {{#if hasFilter}}<a class="btn btn-ghost" href="/products">{{> icon name="x"}} Xóa bộ lọc</a>{{/if}}
</form>

<p class="muted">
  {{#if hasFilter}}Tìm thấy <strong>{{total}}</strong> sản phẩm phù hợp{{#if q}} với “{{q}}”{{/if}}.{{else}}Tổng cộng <strong>{{total}}</strong> sản phẩm.{{/if}}
</p>

{{#if products.length}}
<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th>SKU</th>
        <th>Sản phẩm</th>
        <th>Danh mục</th>
        <th>Kết nối</th>
        <th class="num">Giá</th>
        <th class="num">Tồn</th>
        {{#if currentUser}}<th></th>{{/if}}
      </tr>
    </thead>
    <tbody>
      {{#each products}}
      <tr>
        <td><code>{{sku}}</code></td>
        <td>
          <a href="/products/{{id}}">{{name}}</a>
          <div class="muted small">{{brand_name}}</div>
        </td>
        <td>{{category_name}}</td>
        <td class="muted">{{connection_type}}</td>
        <td class="num">{{formatPrice price}}</td>
        <td class="num">
          {{#if (isLowStock stock)}}<span class="badge {{#if stock}}badge-warn{{else}}badge-err{{/if}}">{{stock}}</span>{{else}}{{stock}}{{/if}}
        </td>
        {{#if ../currentUser}}
        <td class="actions">
          <a class="btn btn-sm" href="/products/{{id}}/edit">{{> icon name="pencil"}} Sửa</a>
          {{#if ../isAdmin}}
          <form action="/products/{{id}}/delete" method="post" data-confirm="Bạn chắc chắn muốn xóa sản phẩm này?">
            <input type="hidden" name="_csrf" value="{{../csrfToken}}">
            <button class="btn btn-sm btn-danger-ghost" type="submit">{{> icon name="trash"}} Xóa</button>
          </form>
          {{/if}}
        </td>
        {{/if}}
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{#if totalPages}}
<nav class="pager">
  {{#if hasPrev}}<a class="btn btn-sm" href="{{prevUrl}}">{{> icon name="chevron-left"}} Trước</a>{{/if}}
  <span class="muted">Trang {{page}} / {{totalPages}}</span>
  {{#if hasNext}}<a class="btn btn-sm" href="{{nextUrl}}">Sau {{> icon name="chevron-right"}}</a>{{/if}}
</nav>
{{/if}}
{{else}}
<div class="card empty">
  <p class="muted">Không tìm thấy sản phẩm nào.</p>
  {{#if currentUser}}
  <a class="btn btn-primary" href="/products/new">{{> icon name="plus"}} Thêm sản phẩm mới</a>
  {{/if}}
</div>
{{/if}}
